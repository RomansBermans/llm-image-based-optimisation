# Required to generate image variants. It is read only by the server.
OPENAI_API_KEY=
# Public URL used in storefront snippets and generated asset URLs.
APP_BASE_URL=http://localhost:3000
# Optional local development locations.
DATABASE_PATH=./data/visual-merchandising.db
IMAGE_STORAGE_PATH=./data/images
# Defaults to the current OpenAI image editing model.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
